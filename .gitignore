# bağımlılıklar, ortamlar, modeller, derlenmiş araçlar (sistem/kur.sh yeniden kurar)
node_modules/
.venv/
.uv/
ortamlar/
modeller/
arac/

# medya ve üretimler: kişisel, büyük — sürümlenmez
projeler/
testler/veri/
testler/.gecici/
*.mp4
*.mov
*.m4v
*.wav
*.aif
*.aiff
*.m4a
*.mp3
*.heic

# satıcı içeriği: lisansı yeniden dağıtıma izin vermiyor ya da belirsiz → kurulumda sabit sürümden üretilir
# (sistem/kur.sh: satici.py ile remotion-best-practices ve HyperFrames becerileri; gsap.min.js node_modules'tan kopyalanır)
sistem/claude/skills/remotion-best-practices/
# HyperFrames becerileri (Apache-2.0; satici.py'deki liste, heygen-com/hyperframes sabit commit'i)
sistem/claude/skills/embedded-captions/
sistem/claude/skills/faceless-explainer/
sistem/claude/skills/figma/
sistem/claude/skills/general-video/
sistem/claude/skills/hyperframes/
sistem/claude/skills/hyperframes-animation/
sistem/claude/skills/hyperframes-audio/
sistem/claude/skills/hyperframes-cli/
sistem/claude/skills/hyperframes-core/
sistem/claude/skills/hyperframes-creative/
sistem/claude/skills/hyperframes-keyframes/
sistem/claude/skills/hyperframes-registry/
sistem/claude/skills/hyperframes-studio/
sistem/claude/skills/media-use/
sistem/claude/skills/motion-graphics/
sistem/claude/skills/music-to-video/
sistem/claude/skills/pr-to-video/
sistem/claude/skills/product-launch-video/
sistem/claude/skills/remotion-to-hyperframes/
sistem/claude/skills/slideshow/
sistem/claude/skills/talking-head-recut/
varliklar/js/
testler/hyperframes-baslik/vendor/

# oturum ara çıktıları (ham ajan sonuçları, eski iş akışı argümanları); kalıcı olanlar: beceri-tanimlari.json, yavas-cekim/
# baş ajan raporları: makineye özgü durum (disk, takas, uygulamalar) — yerelde kalır, herkese açık depoya girmez
sistem/yonetim/
sistem/devam/ham/
sistem/devam/*-args.json
sistem/devam/arastirma-remotion-davinci.js

# araç çıktıları
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.claude/settings.local.json
.claude/agent-memory/

# Bu stüdyoda CLAUDE.md ve .claude/ (iş akışları, proje ayarları) sistemin çekirdeğidir: kullanıcının genel
# ~/.gitignore_global kuralına YALNIZ bu depoda istisna.
!CLAUDE.md
!.claude/
!.claude/workflows/
!.claude/settings.json
